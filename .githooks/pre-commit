#!/bin/sh
# 檢查這次 commit 暫存的 Dart 檔是否已經 dart format；*.g.dart 由 build_runner 產生，不檢查。
# 啟用：git config core.hooksPath .githooks
#
# commit 記錄的是暫存區的內容。暫存後又改過的檔案（部分暫存）逐一取出暫存版本檢查；
# 其餘檔案暫存版本與磁碟相同，直接批次檢查磁碟上的檔案，省下每個檔案各啟動一次 dart。
#
# 檢查不會改檔，但 dart format 的摘要「Formatted N files (1 changed)」看起來像已經排好，
# 所以不顯示它的摘要，只收集排版不符的檔名，最後印出要執行的指令。檔案解析不了（語法
# 錯誤）時 dart format 不會列出檔名，改顯示它的錯誤訊息，一樣擋下。
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- '*.dart' ':!:*.g.dart')
[ -z "$staged" ] && exit 0

bad=""
errors=""
same=""
newline='
'

# dart format 的輸出裡，排版不符的檔名以外、不是摘要也不是 analysis_options 解析警告的
# 那些行，就是解析錯誤。
error_lines() {
  printf '%s\n' "$1" | grep -v -e '^Changed ' -e '^Formatted ' \
    -e '^Warning: Package resolution error' -e '^Failed to resolve package URI'
}

while IFS= read -r f; do
  if git diff --quiet -- "$f"; then
    same="$same$f$newline"
  elif ! result=$(git show ":$f" | dart format --output=none --set-exit-if-changed --stdin-name "$f" 2>&1); then
    if printf '%s\n' "$result" | grep -q '^Changed '; then
      bad="$bad$f$newline"
    else
      failures=$(error_lines "$result")
      errors="$errors${failures:-$result}$newline"
    fi
  fi
done <<EOF
$staged
EOF

# 分批呼叫，避開 Windows 的命令列長度上限。
if [ -n "$same" ] &&
  ! result=$(printf '%s' "$same" | tr '\n' '\0' |
    xargs -0 -n 50 dart format --output=none --set-exit-if-changed 2>&1); then
  changed=$(printf '%s\n' "$result" | sed -n 's/^Changed //p')
  [ -n "$changed" ] && bad="$bad$changed$newline"
  failures=$(error_lines "$result")
  # 失敗了卻認不出原因時，整段照原樣顯示，照樣擋下。
  [ -z "$changed$failures" ] && failures=$result
  [ -n "$failures" ] && errors="$errors$failures$newline"
fi

if [ -n "$errors" ]; then
  {
    echo "pre-commit: dart format 解析不了下面的內容，這次 commit 沒有建立："
    printf '%s' "$errors" | sed 's/^/  /'
  } >&2
fi

if [ -n "$bad" ]; then
  {
    echo "pre-commit: 下面的檔案沒有照 dart format 排版，這次 commit 沒有建立："
    printf '%s' "$bad" | sed 's/^/  /'
    echo "排好後重新 git add 再 commit："
    printf '  dart format'
    printf '%s' "$bad" | while IFS= read -r f; do printf ' %s' "$f"; done
    echo
  } >&2
fi

[ -z "$errors$bad" ] || exit 1
