#!/bin/sh
# 檢查這次 commit 暫存的 Dart 檔是否已經 dart format；*.g.dart 由 build_runner 產生，不檢查。
# 啟用：git config core.hooksPath .githooks
#
# commit 記錄的是暫存區的內容。暫存後又改過的檔案（部分暫存）逐一取出暫存版本檢查；
# 其餘檔案暫存版本與磁碟相同，直接批次檢查磁碟上的檔案，省下每個檔案各啟動一次 dart。
staged=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- '*.dart' ':!:*.g.dart')
[ -z "$staged" ] && exit 0

failed=0
same=""
newline='
'
while IFS= read -r f; do
  if git diff --quiet -- "$f"; then
    same="$same$f$newline"
  elif ! git show ":$f" | dart format --output=none --set-exit-if-changed --stdin-name "$f"; then
    failed=1
  fi
done <<EOF
$staged
EOF

# 分批呼叫，避開 Windows 的命令列長度上限。
if [ -n "$same" ] &&
  ! printf '%s' "$same" | tr '\n' '\0' | xargs -0 -n 50 dart format --output=none --set-exit-if-changed; then
  failed=1
fi

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: 上面列出的檔案格式不符，執行 dart format 後重新 git add。" >&2
  exit 1
fi
