#!/bin/sh
# 推送前檢查：推上 main 時確認 CHANGELOG.md 寫了更新說明（ADR 0010），再跑和 CI 相同的 analyze 與全套測試。
# 啟用：git config core.hooksPath .githooks
set -e

# Git 從標準輸入每行給一個要推的 ref：<local ref> <local sha> <remote ref> <remote sha>。
# 刪除遠端分支時 local sha 全是 0；這次只有刪除、沒有推任何提交時不必跑檢查。
# 功能分支不用寫更新說明，合併進 main 時才寫，所以只檢查推往 main 的範圍。
has_update=0
changelog_failed=0
while read -r _ local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) has_update=1 ;;
    *) continue ;;
  esac
  if [ "$remote_ref" = refs/heads/main ] &&
    ! sh tool/changelog.sh check "$remote_sha" "$local_sha" </dev/null; then
    changelog_failed=1
  fi
done
[ "$has_update" -eq 0 ] && exit 0
if [ "$changelog_failed" -ne 0 ]; then
  echo "pre-push: 推往 main 的更新說明檢查沒有通過，照上面的說明處理後再推送。" >&2
  exit 1
fi

flutter analyze --no-pub
flutter test --no-pub --reporter compact
