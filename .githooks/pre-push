#!/bin/sh
# 推送前檢查：跑和 CI 相同的 analyze 與全套測試。
# 更新說明在手動發測試版時才檢查（ADR 0014），這裡不檢查。
# 啟用：git config core.hooksPath .githooks
set -e

# Git 從標準輸入每行給一個要推的 ref：<local ref> <local sha> <remote ref> <remote sha>。
# 刪除遠端分支時 local sha 全是 0，不必檢查。只改說明文件（任何 .md 與 docs/）
# 的推送也不檢查：測試不讀這些檔，推上去後 CI 照樣會跑。算不出改了哪些檔時
# （遠端那一端本機沒有、新分支找不到和 main 的分岔點）照跑。
zero=0000000000000000000000000000000000000000
needs_check=0
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null)" || { needs_check=1; continue; }
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    needs_check=1
    continue
  fi
  if [ -n "$(git diff --name-only "$base" "$local_sha" -- . ':(exclude,glob)**/*.md' ':(exclude)docs')" ]; then
    needs_check=1
  fi
done
if [ "$needs_check" -eq 0 ]; then
  echo "pre-push: 沒有要推的提交，或只改了說明文件，略過 analyze 與測試。"
  exit 0
fi

flutter analyze --no-pub
flutter test --no-pub --reporter compact
